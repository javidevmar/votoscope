{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/harness/feature_list.schema.json",
  "title": "Harness feature queue",
  "type": "object",
  "required": ["project", "features"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "properties": {
        "one_feature_at_a_time": {
          "type": "boolean"
        },
        "require_tests_to_close": {
          "type": "boolean"
        },
        "require_approved_spec_to_implement": {
          "type": "boolean"
        },
        "valid_status": {
          "type": "array",
          "items": {
            "enum": ["pending", "spec_ready", "in_progress", "done", "blocked"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sdd_required_when": {
          "type": "string"
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "title", "status"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "initiative": {
            "type": "string"
          },
          "sdd": {
            "type": "boolean"
          },
          "status": {
            "enum": ["pending", "spec_ready", "in_progress", "done", "blocked"]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
